# Flask
FLASK_ENV=development
SECRET_KEY=altere-esta-chave-secreta
DATABASE_URL=sqlite:///noticias.db

# E-mail (SMTP). Destinatários do resumo ficam na tela Configurações.
# MAIL_TO só entra como primeiro destinatário se a lista ainda estiver vazia.
MAIL_ENABLED=true
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=sistema@exemplo.com
MAIL_PASSWORD=sua_senha
MAIL_FROM=sistema@exemplo.com
MAIL_TO=voce@exemplo.com

# Servidor local (0.0.0.0 permite acesso pela rede)
APP_HOST=0.0.0.0
APP_PORT=5000
# Vazio = tenta detectar o IP público no link do e-mail
APP_PUBLIC_HOST=

# Texto da matéria: só quando o resumo do feed vier curto
NEWS_FETCH_BODY=true
NEWS_FETCH_MAX_PER_RUN=12
